<div class="product-template">
  <div class="container">
    {% render 'breadcrumbs' %}

    <div class="product-layout" id="Product-{{ product.id }}">
      <!-- Gallery -->
      <div class="product-gallery">
        <div class="product-gallery__main">
          {%- if product.featured_image -%}
            <img
              id="ProductFeaturedImage"
              src="{{ product.featured_image | image_url: width: 800 }}"
              alt="{{ product.featured_image.alt | escape | default: product.title | escape }}"
              loading="eager"
              width="800"
              height="800"
            >
          {%- else -%}
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:4rem;background:var(--color-surface);">🐾</div>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-gallery__thumbnails">
            {%- for image in product.images -%}
              <div class="product-gallery__thumbnail {% if forloop.first %}active{% endif %}">
                <img
                  src="{{ image | image_url: width: 150 }}"
                  data-full="{{ image | image_url: width: 800 }}"
                  alt="{{ image.alt | escape | default: product.title | escape }}"
                  loading="lazy"
                  width="150"
                  height="150"
                >
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product Info -->
      <div class="product-info">
        {%- if product.vendor != blank -%}
          <p class="product-info__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product-info__title">{{ product.title }}</h1>

        <div class="product-info__price">
          {% render 'price', product: product, variant: product.selected_or_first_available_variant %}
        </div>

        <!-- Product Form -->
        {% form 'product', product, data-product-form: '' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" {% unless product.has_only_default_variant %}data-variant-id{% endunless %}>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="variant-selector" data-option-set>
                <span class="variant-selector__label">
                  {{ option.name }}: <strong>{{ option.selected_value }}</strong>
                </span>
                <div class="variant-options">
                  {%- for value in option.values -%}
                    <button type="button" class="variant-option {% if option.selected_value == value %}selected{% endif %}" data-value="{{ value | escape }}">
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <!-- Quantity -->
          <div class="form-field">
            <label class="form-label" for="ProductQuantity">{{ 'product.quantity' | t | default: 'Quantity' }}</label>
            <div class="quantity-selector">
              <button type="button" class="quantity-selector__btn" data-qty-btn="minus" aria-label="{{ 'product.quantity_decrease' | t | default: 'Decrease quantity' }}">−</button>
              <input class="quantity-selector__input" type="number" name="quantity" id="ProductQuantity" value="1" min="1" aria-label="{{ 'product.quantity' | t | default: 'Quantity' }}">
              <button type="button" class="quantity-selector__btn" data-qty-btn="plus" aria-label="{{ 'product.quantity_increase' | t | default: 'Increase quantity' }}">+</button>
            </div>
          </div>

          <!-- Add to Cart -->
          <div class="product-info__atc">
            {%- if product.selected_or_first_available_variant.available -%}
              <button type="submit" class="btn btn--primary btn--lg" data-atc-btn>
                {{ 'product.add_to_cart' | t | default: 'Add to Cart' }}
              </button>
            {%- else -%}
              <button type="button" class="btn btn--primary btn--lg" disabled>
                {{ 'product.sold_out' | t | default: 'Sold Out' }}
              </button>
            {%- endif -%}
          </div>
        {% endform %}

        <!-- Shipping Note -->
        <div class="product-shipping-note">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span>{{ section.settings.shipping_message | default: 'Free shipping on orders over $50. Ships within 1–3 business days.' }}</span>
        </div>

        <!-- Tabs -->
        <div class="product-tabs">
          {%- if product.description != blank -%}
            <div class="product-tab">
              <button class="product-tab__trigger" aria-expanded="false">
                {{ 'product.description' | t | default: 'Description' }}
                {% render 'icon-chevron-down' %}
              </button>
              <div class="product-tab__content">{{ product.description }}</div>
            </div>
          {%- endif -%}

          {%- if section.settings.shipping_info != blank -%}
            <div class="product-tab">
              <button class="product-tab__trigger" aria-expanded="false">
                {{ 'product.shipping_info' | t | default: 'Shipping Info' }}
                {% render 'icon-chevron-down' %}
              </button>
              <div class="product-tab__content">{{ section.settings.shipping_info }}</div>
            </div>
          {%- endif -%}

          {%- if section.settings.returns_policy != blank -%}
            <div class="product-tab">
              <button class="product-tab__trigger" aria-expanded="false">
                {{ 'product.returns' | t | default: 'Returns Policy' }}
                {% render 'icon-chevron-down' %}
              </button>
              <div class="product-tab__content">{{ section.settings.returns_policy }}</div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- Related Products -->
    {%- if section.settings.show_related -%}
      <div class="related-products">
        <h2 class="section-header__title">{{ 'product.related_products' | t | default: 'You May Also Like' }}</h2>
        <div class="product-grid" style="margin-top: 1.5rem;">
          {% assign related_products = product.collections.first.products | where: 'id', product.id %}
          {%- for p in product.collections.first.products limit: 4 -%}
            {%- unless p.id == product.id -%}
              {% render 'product-card', product: p %}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<!-- Variant JSON for JS -->
<script id="ProductVariantData" type="application/json">
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id }},
        "price": {{ variant.price }},
        "compare_at_price": {{ variant.compare_at_price | json }},
        "available": {{ variant.available }},
        "options": {{ variant.options | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

<!-- JSON-LD Product Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "image": "{{ product.featured_image | image_url: width: 800 }}",
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": "{{ product.price_min | money_without_currency }}",
    "highPrice": "{{ product.price_max | money_without_currency }}",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
  }
}
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_related",
      "label": "Show related products",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_message",
      "label": "Shipping message",
      "default": "Free shipping on orders over $50. Ships within 1–3 business days."
    },
    {
      "type": "richtext",
      "id": "shipping_info",
      "label": "Shipping info tab content",
      "default": "<p>We offer free standard shipping on orders over $50. Most orders ship within 1–3 business days. Express shipping is available at checkout.</p>"
    },
    {
      "type": "richtext",
      "id": "returns_policy",
      "label": "Returns policy tab content",
      "default": "<p>We want you to be 100% satisfied. If you're not happy with your purchase, return it within 30 days for a full refund. Items must be unused and in original packaging.</p>"
    }
  ]
}
{% endschema %}
