<div class="account-template">
  <h1 class="account-template__title">{{ 'customer.reset_password.title' | t | default: 'Reset Password' }}</h1>

  {% form 'reset_customer_password' %}
    {%- if form.errors -%}
      <div class="alert alert--error" role="alert">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <p style="color:var(--color-text-muted); margin-bottom:var(--spacing-xl);">
      {{ 'customer.reset_password.subtext' | t | default: 'Enter a new password for your account.' }}
    </p>

    <div class="form-field">
      <label class="form-label" for="ResetPassword">{{ 'customer.reset_password.password' | t | default: 'New Password' }}</label>
      <input class="form-input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
    </div>

    <div class="form-field">
      <label class="form-label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t | default: 'Confirm Password' }}</label>
      <input class="form-input" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
    </div>

    <button type="submit" class="btn btn--primary btn--full">{{ 'customer.reset_password.submit' | t | default: 'Reset Password' }}</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "Reset password",
  "settings": []
}
{% endschema %}
