<div class="account-template">
  <h1 class="account-template__title">{{ 'customer.activate_account.title' | t | default: 'Activate Account' }}</h1>

  {% form 'activate_customer_password' %}
    {%- if form.errors -%}
      <div class="alert alert--error" role="alert">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <p style="color:var(--color-text-muted); margin-bottom:var(--spacing-xl);">
      {{ 'customer.activate_account.subtext' | t | default: 'Create a password to activate your account.' }}
    </p>

    <div class="form-field">
      <label class="form-label" for="ActivatePassword">{{ 'customer.activate_account.password' | t | default: 'Password' }}</label>
      <input class="form-input" type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required>
    </div>

    <div class="form-field">
      <label class="form-label" for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t | default: 'Confirm Password' }}</label>
      <input class="form-input" type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required>
    </div>

    <button type="submit" class="btn btn--primary btn--full">{{ 'customer.activate_account.submit' | t | default: 'Activate Account' }}</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "Activate account",
  "settings": []
}
{% endschema %}
