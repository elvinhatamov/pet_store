<div class="blog-template">
  <div class="container">
    <header class="search-template__header">
      <h1 class="blog-template__title">{{ blog.title }}</h1>
      {%- if blog.articles_count == 0 -%}
        <p style="color:var(--color-text-muted);">{{ 'blog.no_articles' | t | default: 'No articles yet. Check back soon!' }}</p>
      {%- endif -%}
    </header>

    {% paginate blog.articles by 9 %}
      {%- if blog.articles_count > 0 -%}
        <div class="blog-grid">
          {%- for article in blog.articles -%}
            <article class="article-card">
              {%- if article.image -%}
                <div class="article-card__image">
                  <a href="{{ article.url }}">
                    <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape | default: article.title | escape }}" loading="lazy" width="800" height="450">
                  </a>
                </div>
              {%- endif -%}
              <div class="article-card__body">
                <p class="article-card__meta">
                  {{ article.published_at | date: '%B %d, %Y' }}
                  {%- if article.author != blank %} &bull; {{ article.author }}{%- endif -%}
                </p>
                <h2 class="article-card__title">
                  <a href="{{ article.url }}">{{ article.title }}</a>
                </h2>
                {%- if article.excerpt_or_content != blank -%}
                  <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
                {%- endif -%}
                <a href="{{ article.url }}" class="btn btn--outline btn--sm" style="margin-top:1rem;">{{ 'blog.read_more' | t | default: 'Read More' }}</a>
              </div>
            </article>
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
