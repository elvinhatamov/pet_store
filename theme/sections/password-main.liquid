<div class="password-template">
  <div class="password-card">
    <div class="password-card__logo">{{ shop.name }}</div>
    <h1 class="password-card__title">{{ 'password.opening_soon' | t | default: 'Opening Soon' }}</h1>
    <p class="password-card__text">{{ 'password.login_form_heading' | t | default: 'Use the password below to access our store before we officially launch.' }}</p>

    {% form 'storefront_password' %}
      {%- if form.errors -%}
        <div class="alert alert--error" role="alert">
          {{ 'password.wrong_password' | t | default: 'Wrong password. Please try again.' }}
        </div>
      {%- endif -%}

      <div class="form-field" style="text-align:left;">
        <label class="form-label" for="StorePassword">{{ 'password.password_label' | t | default: 'Password' }}</label>
        <input
          class="form-input"
          type="password"
          name="password"
          id="StorePassword"
          autocomplete="current-password"
          required
        >
      </div>

      <button type="submit" class="btn btn--primary btn--full">{{ 'password.submit' | t | default: 'Enter Store' }}</button>
    {% endform %}

    <hr class="divider" style="border-color:var(--color-border); margin-block:1.5rem;">
    <p style="font-size:var(--font-size-xs); color:var(--color-text-muted);">{{ 'password.powered_by_shopify_html' | t }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
