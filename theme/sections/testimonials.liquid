<section class="testimonials section-padding">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        <h2 class="section-header__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="testimonials-grid">
        {%- for block in section.blocks -%}
          <div class="testimonial-card" {{ block.shopify_attributes }}>
            <div class="testimonial-card__stars" aria-label="Rated {{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.rating -%}
                  {% render 'icon-star' %}
                {%- else -%}
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if block.settings.text != blank -%}
              <blockquote class="testimonial-card__text">&ldquo;{{ block.settings.text }}&rdquo;</blockquote>
            {%- endif -%}
            <div class="testimonial-card__author">
              <div class="testimonial-card__author-avatar" aria-hidden="true">
                {{ block.settings.author | split: '' | first | upcase }}
              </div>
              <div>
                <p class="testimonial-card__author-name">{{ block.settings.author }}</p>
                {%- if block.settings.author_label != blank -%}
                  <p class="testimonial-card__author-label">{{ block.settings.author_label }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Happy Pet Parents"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading",
      "default": "Don't just take our word for it"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "My dog absolutely loves the food I ordered from M&M Pet Store. Fast delivery and great quality!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "author_label",
          "label": "Customer label",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "text": "My dog absolutely loves the food I ordered from M&M Pet Store. Fast delivery and great quality!",
            "author": "Sarah M.",
            "author_label": "Verified Buyer"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "text": "Best pet store online! The products are amazing and my cat is obsessed with her new toys.",
            "author": "James R.",
            "author_label": "Verified Buyer"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 4,
            "text": "Great selection of products. Customer service was very helpful when I had a question about my order.",
            "author": "Emily T.",
            "author_label": "Verified Buyer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
