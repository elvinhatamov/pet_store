{% paginate collection.products by section.settings.products_per_page %}

<div class="collection-template">
  <!-- Collection Banner -->
  <div class="collection-banner {% unless collection.image %}collection-banner--no-image{% endunless %}">
    {%- if collection.image -%}
      <img class="collection-banner__bg" src="{{ collection.image | image_url: width: 1920 }}" alt="{{ collection.title | escape }}" loading="eager">
      <div class="collection-banner__overlay"></div>
    {%- endif -%}
    <div class="container">
      <div class="collection-banner__content">
        <h1 class="collection-banner__title">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <div class="collection-banner__description">{{ collection.description }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="container">
    {% render 'breadcrumbs' %}

    <!-- Toolbar -->
    <div class="collection-toolbar">
      <p class="collection-toolbar__count">
        {{ 'collection.products_count' | t: count: collection.products_count | default: collection.products_count | append: ' products' }}
      </p>
      <div class="collection-toolbar__sort">
        <label for="SortBy">{{ 'collection.sort_by_label' | t | default: 'Sort by' }}</label>
        <select class="form-select" id="SortBy" name="sort_by">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
              {{ option.name }}
            </option>
          {%- endfor -%}
        </select>
      </div>
    </div>

    <!-- Product Grid -->
    {%- if collection.products.size > 0 -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="text-center" style="padding: 4rem 0;">
        <p style="font-size:3rem; margin-bottom:1rem;">🔍</p>
        <h2>{{ 'collection.empty' | t | default: 'No products found' }}</h2>
        <p style="color:var(--color-text-muted); margin:1rem 0 2rem;">{{ 'collection.use_fewer_filters' | t | default: 'Try clearing any filters or browse all products.' }}</p>
        <a href="/collections/all" class="btn btn--primary">{{ 'collection.all_products' | t | default: 'Browse All Products' }}</a>
      </div>
    {%- endif -%}

    {% render 'pagination', paginate: paginate %}
  </div>
</div>

{% endpaginate %}

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 24
    }
  ]
}
{% endschema %}
