<section class="section-padding">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        <h2 class="section-header__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="collection-grid">
        {%- for block in section.blocks -%}
          {%- assign collection = collections[block.settings.collection] -%}
          <div class="collection-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img class="collection-card__image" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | default: collection.title | escape }}" loading="lazy" width="600" height="400">
            {%- elsif collection.image -%}
              <img class="collection-card__image" src="{{ collection.image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" loading="lazy" width="600" height="400">
            {%- else -%}
              <div class="collection-card__image" style="background:#e8f5e9; display:flex; align-items:center; justify-content:center; font-size:3rem;">🐾</div>
            {%- endif -%}
            <div class="collection-card__overlay"></div>
            <div class="collection-card__content">
              <h3 class="collection-card__title">
                {{ block.settings.title | default: collection.title | default: 'Collection' }}
              </h3>
              <a href="{% if collection != blank %}{{ collection.url }}{% else %}{{ block.settings.link | default: '/collections/all' }}{% endif %}" class="collection-card__link">
                {{ block.settings.link_label | default: 'Shop Now' }} →
              </a>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading",
      "default": "Find everything your pet needs"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title (optional)"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (if no collection)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        {"type": "collection"},
        {"type": "collection"},
        {"type": "collection"},
        {"type": "collection"}
      ]
    }
  ]
}
{% endschema %}
