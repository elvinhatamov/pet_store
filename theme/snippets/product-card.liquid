<div class="product-card">
  <div class="product-card__image-wrapper">
    <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      {%- if product.featured_image -%}
        <img
          class="product-card__image"
          src="{{ product.featured_image | image_url: width: 500 }}"
          alt="{{ product.featured_image.alt | escape | default: product.title | escape }}"
          loading="lazy"
          width="500"
          height="500"
        >
      {%- else -%}
        <div class="product-card__image-placeholder" aria-hidden="true">🐾</div>
      {%- endif -%}
    </a>

    <div class="product-card__badges">
      {%- if product.compare_at_price_max > product.price -%}
        <span class="badge badge--sale">{{ 'product.sale' | t | default: 'Sale' }}</span>
      {%- endif -%}
      {%- unless product.available -%}
        <span class="badge badge--sold-out">{{ 'product.sold_out' | t | default: 'Sold Out' }}</span>
      {%- endunless -%}
    </div>
  </div>

  <div class="product-card__body">
    {%- if product.vendor != blank -%}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {%- endif -%}
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <div class="product-card__price">
      {% render 'price', product: product %}
    </div>
  </div>

  <div class="product-card__footer">
    <a href="{{ product.url }}" class="btn btn--primary btn--full btn--sm">
      {%- if product.available -%}
        {{ 'product.view_product' | t | default: 'View Product' }}
      {%- else -%}
        {{ 'product.sold_out' | t | default: 'Sold Out' }}
      {%- endif -%}
    </a>
  </div>
</div>
